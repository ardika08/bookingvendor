# ---------------------------------------------------------------------------
# public_html/.htaccess — VendorKit di cPanel
#
# Tiga tugas: teruskan /api, /auth & /sanctum ke Laravel, layani aset statis,
# arahkan sisanya ke SPA (React Router).
# ---------------------------------------------------------------------------

# DirectoryIndex: index.html DULU, baru index.php.
#
# Tanpa ini, LiteSpeed/Apache memprioritaskan index.php untuk permintaan ke
# direktori root (/), sehingga halaman welcome Laravel muncul, bukan SPA.
# index.php tetap dipakai oleh RewriteRule di bawah untuk endpoint /api, /auth,
# dan /sanctum — itu tidak bergantung pada DirectoryIndex.
<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- 1. Endpoint Laravel -------------------------------------------------
    # WAJIB paling atas. Tanpa ini, aturan SPA di bawah menangkap /api/me dan
    # mengembalikan index.html sehingga frontend menerima HTML, bukan JSON.
    #
    # `/sanctum/csrf-cookie` ikut diteruskan: halaman pendaftaran publik
    # mengirim POST sebelum punya sesi, jadi cookie XSRF-TOKEN harus dibuat
    # lebih dulu. Tanpa aturan ini request itu jatuh ke SPA dan dijawab 419.
    RewriteRule ^(api|auth|sanctum)(/.*)?$ index.php [L,QSA]

    # --- 2. Aset statis ------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- 3. SPA --------------------------------------------------------------
    # Route seperti /dashboard atau /jadwal/:slug ditangani React Router.
    RewriteRule ^ index.html [L]
</IfModule>

# Jangan tampilkan daftar isi folder.
Options -Indexes

# Jangan pernah layani berkas sensitif bila tidak sengaja ikut terunggah.
<FilesMatch "^\.(env|git)|composer\.(json|lock)$|\.(sqlite|log|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Aset Vite memuat hash di nama berkas, aman di-cache lama.
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
