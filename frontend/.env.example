# Base URL API Laravel. Kosongkan untuk memakai proxy relatif "/api".
VITE_API_BASE_URL=/api

# Link grup Telegram support vendor. Dipakai tombol "Bantuan & Saran" di sidebar
# dan modal sambutan vendor baru.
VITE_SUPPORT_URL=https://t.me/+7lYGpZo9yPIzOTdl

# Kunci halaman harga & checkout.
#
# true  → klik paket hanya membuka modal "pembayaran belum dibuka"; route
#         /upgrade/checkout/* juga ditolak.
# false → checkout Duitku berjalan normal.
#
# Nilai ini DIBEKUKAN saat `npm run build` (mirip config:cache Laravel).
# Bila tidak diisi, dianggap TERKUNCI (fail-closed).
#
# Pakai true selama akun Duitku produksi belum aktif; set false setelah aktif.
VITE_CHECKOUT_LOCKED=true
